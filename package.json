{
  "name": "aircompass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"evals/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"evals/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "csp:smoke": "playwright test csp",
    "oracle": "node scripts/oracle.mjs",
    "oracle:check": "node scripts/oracle.mjs --check",
    "eval": "tsx evals/run.ts",
    "eval:live": "tsx evals/run.ts --live",
    "sample:build": "tsx scripts/build-sample.ts",
    "measure": "tsx scripts/measure.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run oracle:check && npm run test:coverage && npm run eval && npm run build",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "^4.11.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
